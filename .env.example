# Every environment variable this project uses, with dummy values. Copy to
# .env (gitignored) and fill in real values there; never in this file.
# docs/configuration.md says what each one does.

# --- Audiobookshelf --------------------------------------------------------

# Where the ingester reaches the Audiobookshelf server.
ABS_URL=http://audiobookshelf:13378

# ABS API key (Settings -> API Keys, ABS 2.26+) or a user's API token. The
# user only needs to see the libraries to index and download their ebooks.
ABS_API_TOKEN=REPLACE_ME

# Base for the links stored with each chunk; defaults to ABS_URL.
# ABS_PUBLIC_URL=https://audiobooks.example.com

# Comma-separated library names or ids to index; empty means all. Libraries
# not selected are removed from the collection.
# ABS_LIBRARIES=Audiobooks,Podcasts

# Items per page when listing a library.
# ABS_PAGE_SIZE=100

# Timeout for Audiobookshelf requests, in seconds.
# REQUEST_TIMEOUT_SECONDS=60

# Pause between items, in seconds, to go easy on a small server.
# ITEM_DELAY_SECONDS=0

# --- What to index -----------------------------------------------------------

# Extract text from DRM-free EPUB and PDF files attached to items.
# INGEST_EBOOKS=true
# Skip ebook files larger than this many megabytes.
# EBOOK_MAX_MB=100
# Chapter lists of audiobooks.
# INGEST_CHAPTERS=true
# Podcast episodes and their show notes.
# INGEST_EPISODES=true
# Author pages (book libraries).
# INGEST_AUTHORS=true
# Per-library overview, tallies and catalog.
# INGEST_LIBRARY_SUMMARY=true

# --- Qdrant ----------------------------------------------------------------

# The compose files point this at their own qdrant service.
QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=REPLACE_ME
# QDRANT_COLLECTION=audiobookshelf
# cosine, dot, euclid or manhattan; only used when creating the collection.
# QDRANT_DISTANCE=cosine

# --- Embeddings ------------------------------------------------------------

# openai (the OpenAI API, or any server that speaks it), or sentence_transformers
# (needs the sentence-transformers extra).
# EMBEDDING_PROVIDER=openai
# The default is ModernBERT Embed from Hugging Face, served by a local
# OpenAI-compatible server (see OPENAI_BASE_URL below).
# EMBEDDING_MODEL=nomic-ai/modernbert-embed-base
# EMBEDDING_BATCH_SIZE=32
# Longer texts (at ~4 characters per token) are truncated before embedding.
# The prefixes below count toward this limit.
# EMBEDDING_CONTEXT_LENGTH=8192

# Many embedding models want a task prefix on the text: one for documents being
# stored and another for search queries (the `query` command). A single space
# is added after each. Both default to empty, which is right for OpenAI models.
# Changing EMBEDDING_DOCUMENT_PREFIX changes every stored vector: run once with
# FORCE_REINGEST=true. Anything else that queries Qdrant directly must apply the
# same query prefix itself.
#
#   Model                          EMBEDDING_QUERY_PREFIX   EMBEDDING_DOCUMENT_PREFIX
#   OpenAI text-embedding-3-*      (none)                   (none)
#   nomic-embed-text, ModernBERT   search_query:            search_document:
#     Embed (nomic-ai/modernbert-embed-base)
#   e5 family                      query:                   passage:
#   mxbai-embed-large              Represent this sentence for searching relevant passages:   (none)
#   Qwen3-Embedding and similar    an instruction line      (none)
#
# Set for the default model (nomic-ai/modernbert-embed-base):
EMBEDDING_QUERY_PREFIX=search_query:
EMBEDDING_DOCUMENT_PREFIX=search_document:

# The default model runs on a local OpenAI-compatible server; this example is
# an Ollama on the Docker host (the compose files map host.docker.internal).
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# API key. Optional: leave it unset for a local server that needs none. Set it
# for OpenAI itself (and unset OPENAI_BASE_URL to use api.openai.com).
# OPENAI_API_KEY=REPLACE_ME

# Model cache for sentence_transformers.
# HF_CACHE_DIR=/tmp/hf-cache

# --- Chunking --------------------------------------------------------------

# Characters per chunk, and overlap between neighboring chunks.
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=120

# --- Scheduling ------------------------------------------------------------

# Seconds between syncs; 0 syncs once and exits.
# POLL_INTERVAL_SECONDS=3600
# Re-embed everything on the next sync, ignoring change detection.
# FORCE_REINGEST=false

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# --- Compose (not read by the app) -----------------------------------------

# Release to run with docker-compose.prod.yaml.
# APP_VERSION=latest

# --- Publishing to PyPI (optional; not read by the app) --------------------
# Only for publishing by hand from your machine (`uv publish`); releases
# from GitHub use trusted publishing or the PYPI_API_TOKEN repository
# secret instead; see
# https://github.com/romkey/python-ai-rules/blob/main/docs/releasing.md
# A project-scoped API token from https://pypi.org/manage/account/token/. Keep it out of
# .env on servers: compose passes .env to the app.
# UV_PUBLISH_TOKEN=pypi-REPLACE_ME
